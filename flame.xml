<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="hecker-flame" fetch="https://github.com/its-hecker" />
  <remote name="lineage-flame" fetch="https://github.com/LineageOS" />

  <!-- Coral is the shared source directory for both Pixel 4 models. -->
  <project name="infinity_cnb_android_device_google_coral"
           path="device/google/coral" remote="hecker-flame"
           revision="gcam-experimental-flame" />

  <project name="infinityx_cnb_vendor_google_flame"
           path="vendor/google/flame" remote="hecker-flame"
           revision="gcam-experimental-flame" />

  <!-- floral_defconfig and its DTBO set already support Coral and Flame. -->
  <project name="infinity_cnb_kernel_google_msm-4.14"
           path="kernel/google/msm-4.14" remote="hecker-flame"
           revision="cnb-Latest-stable" sync-s="true" />

  <project name="android_packages_apps_ElmyraService"
           path="packages/apps/ElmyraService" remote="lineage-flame"
           revision="lineage-24.0" />

  <project name="vendor_lunaris_dolby"
           path="vendor/lunaris/dolby" remote="hecker-flame"
           revision="main" />
</manifest>
